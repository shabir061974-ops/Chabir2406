# Copy to backend/.env and fill in real values. NEVER commit the real .env.
MONGO_URL=mongodb://mongo:27017
DB_NAME=faiha
JWT_SECRET=change-me-to-a-64-char-random-hex-secret
ADMIN_EMAIL=admin@faiha.coop
ADMIN_PASSWORD=change-me

# Allowed browser origins for CORS (comma-separated). Native apps are not affected by CORS.
CORS_ORIGINS=https://www.faihacoopkw.com,https://faihacoopkw.com

# Oracle DW (PRODUCT_MASTER) — nightly sync into MongoDB
ORACLE_ENABLED=false
ORA_HOST=your-oracle-host
ORA_PORT=1521
ORA_SERVICE=your-service-name
ORA_USER=your-user
ORA_PASSWORD=your-password
ORA_SCHEMA=your-schema

# Google Sheets integration (optional)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
