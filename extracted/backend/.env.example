DB_NAME="faiha_ecom"
CORS_ORIGINS="https://your-domain.com"

# JWT (generate a new 64-char hex: python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET="REPLACE_WITH_RANDOM_64_HEX"
ADMIN_EMAIL="admin@faiha.coop"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# Oracle PRODUCT_MASTER (read-only) — Oracle 11g requires THICK mode + Instant Client
ORA_HOST="83.96.72.89"
ORA_PORT="1521"
ORA_SERVICE="DW"
ORA_USER="COOP_POS_BO_DB"
ORA_PASSWORD="REPLACE_WITH_ORACLE_PASSWORD"
ORA_SCHEMA="COOP_POS_BO_DB"
ORACLE_ENABLED="true"
# Path to Oracle Instant Client inside the backend container (set by Dockerfile)
ORA_CLIENT_LIB="/opt/oracle/instantclient_19_28"

CURRENCY="KD"
